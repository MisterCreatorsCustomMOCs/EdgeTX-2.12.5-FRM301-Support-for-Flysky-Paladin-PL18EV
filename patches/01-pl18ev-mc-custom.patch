+#if defined(MC_CUSTOM_BUILD)
+// ---------------------------------------------------------------------------
+// MC: battery voltage / percentage on the charge screen and the LED strip.
+// The charge screen runs before the SD card is read, so the voltage
+// calibration and the battery meter range are kept in an RTC backup register
+// (stays alive while the radio is off).
+// ---------------------------------------------------------------------------
+#define MC_BKP_REG    (RTC->BKP19R)
+#define MC_BKP_MAGIC  0x4DU  // 'M'
+
+static uint32_t mcBattSettingsWord()
+{
+  return (MC_BKP_MAGIC << 24) |
+         ((uint32_t)(uint8_t)g_eeGeneral.txVoltageCalibration << 16) |
+         ((uint32_t)(uint8_t)g_eeGeneral.vBatMin << 8) |
+         (uint32_t)(uint8_t)g_eeGeneral.vBatMax;
+}
+
+// runtime: remember the current settings (called every second)
+static void mcStoreBattSettings()
+{
+  uint32_t v = mcBattSettingsWord();
+  if (MC_BKP_REG != v) {
+    HAL_PWR_EnableBkUpAccess();
+    MC_BKP_REG = v;
+  }
+}
+
+// charge screen: restore the settings into g_eeGeneral (overwritten later
+// when the SD card is read)
+void mcLoadBattSettings()
+{
+  __HAL_RCC_PWR_CLK_ENABLE();
+  HAL_PWR_EnableBkUpAccess();
+  uint32_t v = MC_BKP_REG;
+  if ((v >> 24) == MC_BKP_MAGIC) {
+    g_eeGeneral.txVoltageCalibration = (int8_t)((v >> 16) & 0xFF);
+    g_eeGeneral.vBatMin = (int8_t)((v >> 8) & 0xFF);
+    g_eeGeneral.vBatMax = (int8_t)(v & 0xFF);
+  } else {
+    g_eeGeneral.txVoltageCalibration = 0;
+    g_eeGeneral.vBatMin = BATTERY_MIN - 90;
+    g_eeGeneral.vBatMax = BATTERY_MAX - 120;
+  }
+}
+
+static int mcProgress = 0;   // lit segments 0..4 (display + LED strip)
+static uint16_t mcVolt = 0;  // 10 mV
+static int mcPct = -1;       // -1 = unknown
+
+static void mcUpdateLevel(uint16_t chargeState)
+{
+  uint32_t sum = 0;
+  for (int i = 0; i < 4; i++) {
+    adcRead();
+    sum += getBatteryVoltage();
+  }
+  mcVolt = sum / 4;
+
+  int vmin = (g_eeGeneral.vBatMin + 90) * 10;
+  int vmax = (g_eeGeneral.vBatMax + 120) * 10;
+  if (mcVolt < 100 || vmax <= vmin) {
+    mcPct = -1;
+  } else {
+    int pct = ((int)mcVolt - vmin) * 100 / (vmax - vmin);
+    mcPct = limit<int>(0, pct, 100);
+  }
+
+  if (chargeState == CHARGE_FINISHED) {
+    mcPct = 100;
+    mcProgress = 4;
+  } else if (chargeState == CHARGE_STARTED) {
+    // the voltage is lifted while charging: never claim 100 % before "full"
+    if (mcPct > 99) mcPct = 99;
+    int base = mcPct < 0 ? 0 : mcPct / 25;
+    mcProgress++;
+    if (mcProgress > 4 || mcProgress < base) mcProgress = base;
+  } else {
+    mcProgress = 0;
+  }
+}
