+// ---------------------------------------------------------------------------
+// MisterCreators: charge state while the radio is running
+// ---------------------------------------------------------------------------
+
+// called once the radio has left the charge screen / boot
+void mcChargeRuntimeStart()
+{
+#if !defined(MC_NO_RUNTIME_CHARGE)
+  mcRuntimeCharge = true;
+#endif
+}
+
+// called every 10 ms from per10ms()
+void mcChargeTick()
+{
+#if !defined(SIMU)
+  if (!mcRuntimeCharge) return;
+  mcChargeState = get_battery_charge_state();
+#if defined(MC_CUSTOM_BUILD)
+  static uint8_t cnt = 0;
+  if (++cnt >= 100) {
+    cnt = 0;
+    mcStoreBattSettings();
+  }
+#endif
+#endif
+}
+
+// charger (USB or wireless) is connected
+bool mcChargerConnected()
+{
+  if (!mcRuntimeCharge) return false;
+#if defined(WIRELESS_CHARGER)
+  return (uCharger.isChargerDetectionReady && uCharger.hasCharger) ||
+         (wCharger.isChargerDetectionReady && wCharger.hasCharger);
+#else
+  return uCharger.isChargerDetectionReady && uCharger.hasCharger;
+#endif
+}
+
+// 0 = no charger, 1 = charging, 2 = full
+uint8_t mcGetChargeState()
+{
+  if (!mcChargerConnected()) return 0;
+  switch (mcChargeState) {
+    case CHARGE_STARTED:  return 1;
+    case CHARGE_FINISHED: return 2;
+    default:              return 1;  // charger present, state still settling
+  }
+}
+
+// 0 = none, 1 = USB, 2 = wireless
+uint8_t mcGetChargeSource()
+{
+  if (!mcRuntimeCharge) return 0;
+  if (uCharger.isChargerDetectionReady && uCharger.hasCharger) return 1;
+#if defined(WIRELESS_CHARGER)
+  if (wCharger.isChargerDetectionReady && wCharger.hasCharger) return 2;
+#endif
+  return 0;
+}
+
+#if defined(USB_CHARGER)
+// charge bolt in the top bar battery icon
+bool usbChargerLed()
+{
+  return mcGetChargeState() == 1;
+}
+#endif
