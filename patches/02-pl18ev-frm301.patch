+#if defined(FRM301_DEBUG)
+/*
+ * MC test 15: log of the serial traffic with the FRM301 on the SD card.
+ * Starts with every bind, runs 25 s, is collected in RAM (SDRAM) and then
+ * written in small pieces to /LOGS/frm301.log (appended, one block per
+ * bind). Our own channel frames (0x07) are only counted, not logged.
+ * Record in RAM: time (2, 10 ms ticks), dir (1), len (1), bytes (unescaped)
+ */
+#define FRMLOG_SIZE   (64 * 1024)
+#define FRMLOG_TIME   2500  // 25 s
+static uint8_t frmLogBuf[FRMLOG_SIZE] __SDRAM;
+static volatile uint32_t frmLogPos = 0;
+static volatile bool frmLogOn = false;
+static bool frmLogFull = false;
+static tmr10ms_t frmLogStart = 0;
+static tmr10ms_t frmLogUntil = 0;
+static uint32_t frmLogChannels = 0;  // own 0x07 frames, not logged
+static uint8_t frmLogState = 0;       // 0 idle, 1 recording, 2 writing, 3 written
+static uint8_t frmLogSession = 0;
+static uint32_t frmLogWritePos = 0;
+static FIL frmLogFile;
+
+static void frmLogAppend(char dir, const uint8_t* p, uint32_t n)
+{
+  if (n > 255) n = 255;
+  tmr10ms_t t = get_tmr10ms() - frmLogStart;
+  __disable_irq();
+  uint32_t pos = frmLogPos;
+  if (frmLogOn && pos + 4 + n <= FRMLOG_SIZE) {
+    frmLogBuf[pos] = t & 0xFF;
+    frmLogBuf[pos + 1] = (t >> 8) & 0xFF;
+    frmLogBuf[pos + 2] = (uint8_t)dir;
+    frmLogBuf[pos + 3] = (uint8_t)n;
+    memcpy(&frmLogBuf[pos + 4], p, n);
+    frmLogPos = pos + 4 + n;
+  } else if (frmLogOn) {
+    frmLogFull = true;
+    frmLogOn = false;
+  }
+  __enable_irq();
+}
+
+void frmLogFrame(char dir, const uint8_t* p, uint32_t len, bool escaped)
+{
+  if (!frmLogOn) return;
+  // test 16: decoded straight into the log buffer (no big stack buffer -
+  // this runs in the mixer task and the serial receive path)
+  tmr10ms_t t = get_tmr10ms() - frmLogStart;
+  __disable_irq();
+  uint32_t pos = frmLogPos;
+  if (!frmLogOn || pos + 4 + 255 > FRMLOG_SIZE) {
+    if (frmLogOn) { frmLogFull = true; frmLogOn = false; }
+    __enable_irq();
+    return;
+  }
+  uint8_t* d = &frmLogBuf[pos + 4];
+  uint32_t n = 0;
+  for (uint32_t i = 0; i < len && n < 255; i++) {
+    uint8_t b = p[i];
+    if (escaped && b == 0xDB && i + 1 < len) {
+      uint8_t c = p[++i];
+      b = (c == 0xDC) ? 0xC0 : (c == 0xDD) ? 0xDB : c;
+    }
+    d[n++] = b;
+  }
+  // own channel data (C0 addr num type=05 cmd=07 ...) is only counted
+  if (dir == 'T' && n > 4 && d[3] == 0x05 && d[4] == 0x07) {
+    frmLogChannels++;
+  } else {
+    frmLogBuf[pos] = t & 0xFF;
+    frmLogBuf[pos + 1] = (t >> 8) & 0xFF;
+    frmLogBuf[pos + 2] = (uint8_t)dir;
+    frmLogBuf[pos + 3] = (uint8_t)n;
+    frmLogPos = pos + 4 + n;
+  }
+  __enable_irq();
+}
+
+static void frmLogEvent(const char* text)
+{
+  if (frmLogOn) frmLogAppend('E', (const uint8_t*)text, strlen(text));
+}
+
+bool frmLogEnabled = false;  // test 21: SD log only when switched on
+static void frmLogBegin()
+{
+  if (!frmLogEnabled) return;
+  if (frmLogState == 2) return;  // still writing the last one
+  if (frmLogOn) {                // already running: just extend
+    frmLogUntil = get_tmr10ms() + FRMLOG_TIME;
+    return;
+  }
+  frmLogPos = 0;
+  frmLogFull = false;
+  frmLogChannels = 0;
+  frmLogStart = get_tmr10ms();
+  frmLogUntil = frmLogStart + FRMLOG_TIME;
+  frmLogSession++;
+  frmLogState = 1;
+  frmLogOn = true;
+}
+
+// called from setupFrame(): ends the recording and writes it in small parts
+static void frmLogService()
+{
+  if (frmLogState == 1) {
+    if (frmLogOn && (int32_t)(get_tmr10ms() - frmLogUntil) < 0) return;
+    frmLogOn = false;
+    if (!sdMounted() || frmLogPos == 0) {
+      frmLogState = 0;
+      return;
+    }
+    f_mkdir(LOGS_PATH);
+    if (f_open(&frmLogFile, LOGS_PATH "/frm301.log",
+               FA_OPEN_APPEND | FA_WRITE) != FR_OK) {
+      frmLogState = 0;
+      return;
+    }
+    char head[160];
+    UINT bw;
+    int l = snprintf(head, sizeof(head),
+                     "\n=== FRM301 Mitschnitt %u (MC T25), %lu Bytes%s ===\n"
+                     "Zeit[s] Richtung (T=Funke->Modul R=Modul->Funke "
+                     "E=Ereignis) Rahmen: C0 Adr Nr Typ Bef Daten.. CRC C0\n",
+                     frmLogSession, (unsigned long)frmLogPos,
+                     frmLogFull ? ", Puffer voll" : "");
+    f_write(&frmLogFile, head, l, &bw);
+    frmLogWritePos = 0;
+    frmLogState = 2;
+    return;
+  }
+  if (frmLogState != 2) return;
+
+  static char line[900];
+  UINT bw;
+  for (uint8_t k = 0; k < 4; k++) {
+    if (frmLogWritePos + 4 > frmLogPos) {
+      int l = snprintf(line, sizeof(line),
+                       "(nicht protokolliert: %lu eigene Kanal-Rahmen 0x07)\n",
+                       (unsigned long)frmLogChannels);
+      f_write(&frmLogFile, line, l, &bw);
+      f_close(&frmLogFile);
+      frmLogState = 3;
+      return;
+    }
+    const uint8_t* r = &frmLogBuf[frmLogWritePos];
+    uint16_t t = r[0] | (r[1] << 8);
+    char dir = (char)r[2];
+    uint8_t n = r[3];
+    int l = snprintf(line, sizeof(line), "%3u.%02u %c ", t / 100, t % 100, dir);
+    for (uint8_t i = 0; i < n; i++) {
+      if (dir == 'E')
+        line[l++] = (char)r[4 + i];
+      else
+        l += snprintf(line + l, sizeof(line) - l, "%02X ", r[4 + i]);
+    }
+    line[l++] = '\n';
+    f_write(&frmLogFile, line, l, &bw);
+    frmLogWritePos += 4 + n;
+  }
+}
