+// switch the module bay off; setupFrame() switches it on again after 300 ms
+void ProtoState::modulePowerCycle(const char* why)
+{
+  frmLogEvent(why);
+  modulePortSetPower(module_index, 0);
+  pwrPhase = 1;
+  pwrReady = false;
+  pwrTime = get_tmr10ms();
+  pwrCycles++;
+  closedLinkUp = false;
+  cfgPush = 0;
+  lastPart = 0;
+  lastReqTime = 0;
+  trsp.modReq.valid = false;
+  state = ModuleState::STATE_NOT_READY;
+  clearFrameData();
