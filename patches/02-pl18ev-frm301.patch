+#if defined(FRM301_DEBUG)
+// MC: line 0 = counters, line 1/2 = last frames from the module (hex)
+void getDiagString(uint8_t module, uint8_t line, char* buf, size_t len)
+{
+  const FrmDiag& d = protoState[module].getDiag();
+  auto& ps = protoState[module];
+  if (line == 0) {
+    snprintf(buf, len, "A%u St%u RX%u CRC%u Own%u", ps.getDevAddress(),
+             ps.getRawState(), d.rxFrames, d.crcErrors, d.ownSent);
+    return;
+  }
+  if (line == 1) {
+    // module states, oldest -> newest
+    uint8_t h[8], idx;
+    ps.getHist(h, idx);
+    size_t pos = snprintf(buf, len, "Status:");
+    for (uint8_t k = 0; k < 8 && pos < len; k++) {
+      uint8_t v = h[(idx + k) & 7];
+      if (v == 0xEE) continue;
+      pos += snprintf(buf + pos, len - pos, " %X", v);
+    }
+    return;
+  }
+  uint8_t v[8];
+  ps.getBindInfo(v);
+  if (line == 2) {
+    // test 15: P = power phase (1 off, 2 booting) / restarts, Log state
+    static const char* const logTxt[] = {"-", "laeuft", "schreibt", "fertig"};
+    snprintf(buf, len, "Bind S%u V%u Teile%02X P%u/%u Log %s %luk", v[0], v[1],
+             v[2], ps.getPwrPhase(), ps.getPwrCycles(),
+             logTxt[frmLogState & 3],
+             (unsigned long)(frmLogPos / 1024));
+    return;
+  }
+  if (line == 3) {
+    // receiver block: count, frame type/length, first byte, ID at 0x40
+    // test 22: L/S = FatFS result of loading / saving <model>.frm301
+    // (0 ok, 4 = file not found, EE = not tried, F0 = too short)
+    snprintf(buf, len, "RXblk x%u neu %08lX gesp %08lX L%X S%X", v[5],
+             (unsigned long)ps.lastRxId,
+             ps.rxBlockValid ? (unsigned long)ps.rxId() : 0UL,
+             ps.loadRes, ps.saveRes);
+    return;
+  }
+  // last frame from the module
+  size_t pos = snprintf(buf, len, "Letzter: ");
+  uint8_t i = (d.lastIdx + 3) & 3;
+  uint8_t m = d.lastLen[i] > sizeof(d.last[0]) ? sizeof(d.last[0]) : d.lastLen[i];
+  for (uint8_t b2 = 0; b2 < m && pos < len; b2++)
+    pos += snprintf(buf + pos, len - pos, "%02X", d.last[i][b2]);
+}
