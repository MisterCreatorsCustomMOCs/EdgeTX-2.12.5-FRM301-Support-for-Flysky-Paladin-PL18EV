+void ProtoState::modulePowerCycle()
+{
+  modulePortSetPower(module_index, 0);
+  pwrPhase = 1;
+  pwrReady = false;
+  pwrTime = get_tmr10ms();
+  closedLinkUp = false;
+  cfgPush = 0;
+  lastPart = 0;
+  lastReqTime = 0;
+  trsp.modReq.valid = false;
+  state = ModuleState::STATE_NOT_READY;
+  clearFrameData();
